# Copy to deploy/.env and replace every CHANGE_ME. Never commit deploy/.env.
BLUEOFFICE_IMAGE=blueoffice/server:0.6.0
PUBLIC_ORIGIN=https://office.example.gov.vn
API_BIND=127.0.0.1
API_PORT=8080

POSTGRES_PASSWORD=CHANGE_ME
REDIS_PASSWORD=CHANGE_ME
MINIO_ROOT_USER=blueoffice
MINIO_ROOT_PASSWORD=CHANGE_ME
MAX_UPLOAD_BYTES=209715200

# OIDC (Keycloak realm or compatible provider)
OIDC_AUTHORITY=https://sso.example.gov.vn/realms/blueoffice
OIDC_AUDIENCE=blueoffice-api
OIDC_REQUIRE_HTTPS=true

# Optional Keycloak (profile "sso"); its database is created by deploy/postgres-init
KEYCLOAK_HOSTNAME=sso.example.gov.vn
KEYCLOAK_ADMIN=admin
KEYCLOAK_ADMIN_PASSWORD=CHANGE_ME

# BlueDrive integration (BOHP, docs/bohp.md)
BLUEDRIVE_BOHP_URL=https://drive.example.gov.vn/bohp/v1
BLUEDRIVE_JWKS_URL=https://drive.example.gov.vn/.well-known/jwks.json
BLUEDRIVE_ISSUER=https://drive.example.gov.vn
BLUEDRIVE_WEBHOOK_URL=https://drive.example.gov.vn/webhooks/blueoffice
BLUEDRIVE_WEBHOOK_SECRET=CHANGE_ME
BLUEDRIVE_ORIGIN=https://drive.example.gov.vn
# Desktop Start screen sign-in (OAuth 2.0 code + PKCE, public client; redirect bluedoc://auth, bluesheet://auth, blueslide://auth).
# Leave empty to offer token sign-in only.
BLUEDRIVE_SIGNIN_AUTHORIZE_URL=
BLUEDRIVE_SIGNIN_TOKEN_URL=
BLUEDRIVE_SIGNIN_CLIENT_ID=blueoffice-desktop

WORKER_REPLICAS=1
WORKER_CONCURRENCY=2
OTEL_ENDPOINT=
