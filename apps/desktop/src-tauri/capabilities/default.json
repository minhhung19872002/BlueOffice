{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "Main window capabilities",
  "windows": [
    "main",
    "doc-*"
  ],
  "permissions": [
    "core:default",
    "core:window:allow-set-title",
    "dialog:default",
    "core:window:allow-unminimize",
    "core:window:allow-set-focus",
    "deep-link:default"
  ]
}
