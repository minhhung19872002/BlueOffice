{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "BlueSheet",
  "identifier": "vn.bluestar.bluesheet",
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "BlueSheet – Bảng tính",
        "url": "index.html?app=sheet",
        "width": 1280,
        "height": 860,
        "minWidth": 720,
        "minHeight": 480,
        "decorations": false,
        "transparent": true
      }
    ]
  },
  "bundle": {
    "shortDescription": "BlueSheet – Bảng tính",
    "fileAssociations": [
      {
        "ext": [
          "xlsx"
        ],
        "name": "BlueSheet workbook",
        "description": "Tương thích định dạng Microsoft Excel (.xlsx)",
        "role": "Editor",
        "mimeType": "application/vnd.openxmlformats-officedocument.spreadsheetml.sheet"
      },
      {
        "ext": [
          "xlsm"
        ],
        "name": "BlueSheet macro-enabled workbook",
        "description": "Tương thích định dạng bảng tính có macro (.xlsm)",
        "role": "Editor",
        "mimeType": "application/vnd.ms-excel.sheet.macroEnabled.12"
      },
      {
        "ext": [
          "xltx"
        ],
        "name": "BlueSheet template",
        "description": "Tương thích định dạng mẫu bảng tính (.xltx)",
        "role": "Editor",
        "mimeType": "application/vnd.openxmlformats-officedocument.spreadsheetml.template"
      },
      {
        "ext": [
          "xltm"
        ],
        "name": "BlueSheet macro-enabled template",
        "description": "Tương thích định dạng mẫu bảng tính có macro (.xltm)",
        "role": "Editor",
        "mimeType": "application/vnd.ms-excel.template.macroEnabled.12"
      }
    ]
  },
  "plugins": {
    "deep-link": {
      "desktop": {
        "schemes": [
          "bluesheet"
        ]
      }
    },
    "updater": {
      "pubkey": "REPLACE_WITH_BLUESTAR_UPDATER_PUBLIC_KEY",
      "endpoints": [
        "https://updates.bluestar.vn/blueoffice/bluesheet/{{target}}/{{arch}}/{{current_version}}"
      ]
    }
  }
}
