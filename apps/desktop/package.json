{
  "name": "@blueoffice/desktop",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "predev": "node ../../scripts/sync-assets.mjs public",
    "dev": "vite",
    "prebuild": "node ../../scripts/sync-assets.mjs public",
    "build": "vite build",
    "tauri": "tauri",
    "build:bluesheet": "tauri build --no-bundle --config src-tauri/tauri.bluesheet.conf.json",
    "build:blueslide": "tauri build --no-bundle --config src-tauri/tauri.blueslide.conf.json",
    "typecheck": "tsc -p tsconfig.json"
  },
  "dependencies": {
    "@blueoffice/editor": "workspace:*",
    "@blueoffice/platform": "workspace:*",
    "@blueoffice/storage-providers": "workspace:*",
    "@tauri-apps/api": "^2.12.4",
    "react": "18.3.1",
    "react-dom": "18.3.1"
  },
  "devDependencies": {
    "@tauri-apps/cli": "^2.12.4",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^6.2.1",
    "typescript": "~5.9.3",
    "vite": "^8.3.6"
  }
}
