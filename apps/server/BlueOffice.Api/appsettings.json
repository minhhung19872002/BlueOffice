{
  "Serilog": {
    "MinimumLevel": {
      "Default": "Information",
      "Override": { "Microsoft.AspNetCore": "Warning", "Microsoft.EntityFrameworkCore": "Warning" }
    }
  },
  "ConnectionStrings": {
    "Default": "Data Source=data/blueoffice.db",
    "Redis": "localhost:6379"
  },
  "Database": { "Provider": "Sqlite", "AutoCreate": true },
  "Storage": { "Provider": "FileSystem", "Root": "data/objects", "MaxUploadBytes": 209715200 },
  "Jobs": { "Provider": "InMemory", "Concurrency": 2 },
  "Worker": { "Enabled": true, "WaitTimeout": "00:01:00" },
  "BoCli": {
    "ExecutablePath": "bo-cli",
    "Timeout": "00:01:00"
  },
  "Auth": {
    "Authority": "",
    "Audience": "blueoffice-api",
    "RequireHttpsMetadata": true,
    "WebClient": { "ClientId": "", "Scope": "openid profile" }
  },
  "Collab": {
    "AutosaveInterval": "00:00:45",
    "TickInterval": "00:00:02",
    "SnapshotInterval": "00:01:00",
    "PermissionRecheckInterval": "00:01:00"
  },
  "Hosts": [],
  "Cors": { "Origins": [] },
  "RestApi": { "Enabled": false, "AllowBearer": true, "MaxUploadBytes": 52428800, "RateLimit": { "PermitLimit": 60, "Window": "00:01:00" }, "Keys": [] },
  "Translation": { "Provider": "None" },
  "Dictation": { "Provider": "None" },
  "AI": { "Enabled": false },
  "Otel": { "Enabled": true, "Endpoint": "", "ServiceName": "blueoffice-api" },
  "AllowedHosts": "*"
}
