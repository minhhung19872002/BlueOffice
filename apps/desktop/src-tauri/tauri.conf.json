{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "BlueDoc",
  "version": "0.1.0",
  "identifier": "vn.bluestar.bluedoc",
  "build": {
    "beforeDevCommand": "pnpm dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "pnpm build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "BlueDoc – Soạn thảo văn bản",
        "url": "index.html?app=doc",
        "width": 1280,
        "height": 860,
        "minWidth": 720,
        "minHeight": 480
      }
    ],
    "security": {
      "csp": "default-src 'self'; img-src 'self' data: blob:; style-src 'self' 'unsafe-inline'; connect-src 'self' ipc: http://ipc.localhost; worker-src 'self' blob:"
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "shortDescription": "BlueDoc – Soạn thảo văn bản",
    "publisher": "Bluestar",
    "copyright": "© Bluestar",
    "category": "Productivity",
    "icon": ["icons/32x32.png", "icons/128x128.png", "icons/128x128@2x.png", "icons/icon.icns", "icons/icon.ico"],
    "fileAssociations": [
      {
        "ext": ["docx"],
        "name": "BlueDoc document",
        "description": "Tương thích định dạng Microsoft Word (.docx)",
        "role": "Editor",
        "mimeType": "application/vnd.openxmlformats-officedocument.wordprocessingml.document"
      }
    ]
  }
}
